{
  "name": "ladarr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n webapp,server -c cyan,green \"npm run dev -w @ladarr/webapp\" \"npm run dev -w @ladarr/server\"",
    "build": "npm run build -w @ladarr/webapp",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/webapp && tsc -p e2e",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "bench": "npm run build && node bench/bench.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
